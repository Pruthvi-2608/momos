{
  "name": "momos-and-stuff",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "motion": "14.6.0",
    "lucide-react": "1.61.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.19.0",
    "@eslint/js": "9.19.0",
    "globals": "14.0.0"
  }
}
